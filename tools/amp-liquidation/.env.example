# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5    # optional override

# eBay (production)
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_USER_TOKEN=                     # OAuth2 user token, scope: sell.inventory (informational; runtime uses refresh token)
EBAY_REFRESH_TOKEN=
EBAY_RUNAME=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_CATEGORY_ID=                    # eBay leaf category for the FOURFRONT listing (default: 80)

# Gmail (for filter creation + receiving inquiries)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=keith@1commercesolutions.com

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=                      # 1commercesolutions team
LINEAR_PROJECT_ID=                   # create "AMP Liquidation" project, paste id
LINEAR_WEBHOOK_URL=http://localhost:3001/lead    # used by `npm run poll`

# Stripe
STRIPE_SECRET_KEY=

# Pickup info
SELLER_LOCATION_ZIP=97013
SELLER_PHONE=

# Webhook server port (linear-webhook)
PORT=3001
